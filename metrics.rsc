1:["$","$Lc",null,{"current":"metrics","children":[["$","section",null,{"className":"chapter-start","id":"start","children":[["$","div",null,{"className":"chapter-start-copy","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"chapter-pill","children":"05"}]," ","Следующий шаг"]}],["$","h1",null,{"children":"Что считать настоящим успехом?"}],["$","p",null,{"children":"У новой формы вырос средний чек. Хорошая новость? Не обязательно: возможно, мелкие покупатели просто перестали покупать. Точно посчитать число ещё недостаточно — нужно выбрать число, которое отвечает на наш вопрос."}],["$","p",null,{"children":"Разберём роли метрик, единицу расчёта и ограничения по вреду. В конце соберём понятные правила: по чему судим об успехе и когда выпуск пока не обоснован."}],["$","div",null,{"className":"chapter-route","children":"Цель → метрика → защита → решение"}]]}],["$","$Lf",null,{"chapter":"metrics"}]]}],["$","nav",null,{"className":"lesson-toc","aria-label":"Разделы главы","children":[["$","a",null,{"href":"#metric-question","children":"Точный вопрос"}],["$","a",null,{"href":"#metric-roles","children":"Роли метрик"}],["$","a",null,{"href":"#metric-unit","children":"Единица расчёта"}],["$","a",null,{"href":"#guardrails","children":"Допустимый вред"}],["$","a",null,{"href":"#real-microsoft","children":"История Microsoft"}],["$","a",null,{"href":"#metrics-work","children":"Паспорт метрик"}]]}],["$","div",null,{"className":"play-shortcuts","children":[["$","span",null,{"children":"Лаборатории по теме"}],["$","a",null,{"href":"#metric-roles-lab","children":"Собрать набор метрик"}],["$","a",null,{"href":"#denominator-lab","children":"Ловушка среднего чека"}],["$","a",null,{"href":"#guardrail-lab","children":"Можно выпускать?"}]]}],["$","$L10",null,{"id":"metric-question","index":"05.1","title":"Сначала вопрос, потом число в отчёте","children":[["$","p",null,{"children":["Продолжаем пример короткой формы покупки. «Сделать продукт лучше» — хорошее намерение, но по нему нельзя проверить результат. Уточним: ",["$","strong",null,{"children":"помогает ли новая форма большему числу подходящих посетителей завершить покупку за 7 дней?"}]]}],["$","p",null,{"children":["Теперь можно определить ",["$","strong",null,{"children":"метрику"}]," — правило, по которому из данных получаем число. Основная метрика здесь — доля назначенных участников, оплативших хотя бы один заказ за 7 дней. В A и B считаем одним способом."]}],["$","div",null,{"className":"metric-question-flow","children":[["$","div",null,{"children":[["$","span",null,{"children":"Цель пользователя"}],["$","strong",null,{"children":"Завершить покупку"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Изменение"}],["$","strong",null,{"children":"Меньше обязательных полей"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Ожидаемый механизм"}],["$","strong",null,{"children":"Меньше людей бросают форму"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"Измерение"}],["$","strong",null,{"children":"Покупка за 7 дней"}]]}]]}],["$","h3",null,{"children":"Уточним четыре детали"}],["$","ol",null,{"className":"work-steps","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Кого изучаем?"}]," Подходящих посетителей, случайно назначенных в A или B. Условие участия определяем до показа формы."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Что считаем результатом?"}]," Хотя бы один успешно оплаченный заказ. Три заказа одного человека дают ему результат 1, а не 3."]}],["$","li",null,{"children":[["$","strong",null,{"children":"За какой срок?"}]," Семь дней после назначения. Каждый получает одинаковое время на покупку."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Что сравниваем?"}]," Долю покупателей в B минус долю покупателей в A, в процентных пунктах."]}]]}],["$","section",null,{"className":"reading-compare","aria-label":"Как связаны вопрос и расчёт","children":[["$","div","Что хотим узнать",{"children":[["$","span",null,{"className":"reading-compare-label","children":"Что хотим узнать"}],["$","h3",null,{"children":"Целевой эффект"}],["$","p",null,{"children":"Как новая форма меняет вероятность покупки за 7 дней у заданных участников. В документах аналитиков это называют estimand."}]]}],"$L11"]}],"$L12","$L13"]}],"$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]
