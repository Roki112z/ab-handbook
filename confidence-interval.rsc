n class="mord text"><span class="mord cyrillic_fallback">расходы</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.8804em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">×</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:0.8056em;vertical-align:-0.0556em;"></span><span class="mord">100%</span></span></span></span></span>22:["$","section",null,{"className":"real-story","id":"real-ebay","aria-labelledby":"real-ebay-title","children":[["$","header",null,{"className":"story-header","children":[["$","div",null,{"className":"story-kicker","children":[["$","span",null,{"children":[["$","$L29",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v16","key":"1f6ucr"}],["path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15,"aria-hidden":"true"}]," Реальная история"]}],["$","span",null,{"children":"Статья · 2015"}]]}],["$","div",null,{"className":"story-company","children":[["$","span",null,{"className":"company-mark ebay","children":["$","$L37",null,{"src":"/ab-handbook/brands/ebay.svg","width":54,"height":34,"alt":"","unoptimized":true}]}],["$","span",null,{"children":"eBay"}]]}],["$","h2",null,{"id":"real-ebay-title","children":"За рекламу заплатили. Какие покупки она действительно добавила?"}],["$","p",null,{"className":"story-lesson","children":"Что такое ROI и зачем измерять отдачу сейчас, если клиент может вернуться позже."}]]}],["$","div",null,{"className":"story-body","children":[["$","h3",null,{"children":"Зачем понадобился эксперимент"}],["$","p",null,{"children":"eBay — площадка для покупки и продажи товаров. Если человек нажал на поисковую рекламу и купил, нельзя автоматически приписать всю покупку рекламе: он мог и без неё найти eBay."}],["$","p",null,{"children":"Для случайно выбранной части географических рынков США на 60 дней отключили рекламу по запросам без названия eBay. Сравнение помогло оценить, сколько продаж реклама действительно добавляла. Затем авторы использовали экспериментальный эффект и открытые финансовые данные для расчёта ROI."}],["$","h3",null,{"children":"Что означает ROI"}],["$","div",null,{"className":"story-definition","children":[["$","strong",null,{"children":"ROI — return on investment, отдача на вложенные деньги"}],["$","p",null,{"children":"В этой статье считают: дополнительная выручка eBay благодаря рекламе минус расходы на рекламу; затем делят на эти расходы. Дополнительная — та, которой без рекламы не было бы."}],["$","p",null,{"children":"Выручка eBay — доход самой площадки, а не вся стоимость товаров продавцов. В расчёте статьи вычитают рекламные расходы; это не полный расчёт прибыли со всеми издержками бизнеса."}]]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$38"}}]}],"$L39"]}],"$L3a","$L3b","$L3c","$L3d","$L3e","$L3f","$L40","$L41","$L42"]}],"$L43"]}]
23:["$","$Lf",null,{"id":"senior","index":"УЧЕБНЫЙ КЕЙС","title":"Ноль внутри — значит, проект провалился?","children":[["$","p",null,{"children":["Новую форму оформления заказа дешевле поддерживать. Это учебный сценарий: даже без роста продаж компания может выиграть за счёт снижения затрат. До теста установили допустимый предел потери конверсии −0,20 п.п. Правило: нижняя граница 95%-го двустороннего интервала должна быть выше этого предела. Проверки данных и остальные защитные метрики пройдены. Получен ДИ ",["$","strong",null,{"children":"[−0,131; +0,931] п.п."}]]}],["$","figure",null,{"className":"lesson-visual","children":[["$","div",null,{"className":"visual-title","children":"В этом кейсе важна граница допустимого вреда"}],[["$","div",null,{"className":"interval-key","children":[["$","span",null,{"children":"Пунктир: нулевой эффект"}],["$","span",null,{"children":["Допустимая потеря −0,20"," п.п."]}]]}],[["$","div","Результат более дешёвой формы",{"className":"interval-example","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Результат более дешёвой формы"}],["$","span",null,{"children":["[","−0,131","; ","+0,931","] п.п."]}]]}],["$","div",null,{"className":"interval-example-track","role":"img","aria-label":"Результат более дешёвой формы: интервал от −0,131 до +0,931 п.п.; оценка +0,400 п.п.","children":[["$","i",null,{"className":"interval-reference","style":{"left":"23.93827899945809%"}}],["$","i",null,{"className":"interval-reference business","style":{"left":"9.67741935483871%"}}],["$","i",null,{"className":"interval-span","style":{"left":"14.597415932232394%","width":"75.72516471292889%"}}],["$","i",null,{"className":"interval-estimate","style":{"left":"52.45999828869684%"}}]]}],["$","p",null,{"children":"Ноль лежит внутри. Но нижняя граница интервала выше заранее выбранного предела потери."}]]}]],["$","div",null,{"className":"small-axis","children":[["$","span",null,{"children":"−0,336"}],["$","span",null,{"children":"Разница конверсий, п.п."}],["$","span",null,{"children":"+1,067"}]]}]],["$","figcaption",null,{"children":"Не утверждаем, что снижение невозможно. Проверяем конкретное условие, согласованное до запуска: нижняя граница этого интервала выше −0,20 п.п."}]]}],["$","$L35",null,{"id":"ci-senior","question":"Менеджер предлагает закрыть проект, потому что интервал пересекает ноль. Что ответить?","options":["Пересечение нуля всегда означает провал","Рост не подтверждён, но заранее выбранная проверка допустимой потери пройдена","Теперь можно заявить, что вред полностью исключён"],"correct":1,"explanation":"Нижняя граница −0,131 выше предела −0,20 п.п. По правилу, заданному до запуска, проверка допустимой потери пройдена. Если остальные критерии тоже выполнены, снижение затрат может обосновывать выпуск без доказанного роста. Нельзя заявлять «вреда нет» или выбирать удобный предел задним числом."}],["$","aside",null,{"className":"work-note","aria-label":"На работе: Свяжите допустимое снижение с экономией","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L29",null,{"ref":"$undefined","iconNode":"$1a:props:children:0:props:children:0:props:iconNode","className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Свяжите допустимое снижение с экономией"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Предел −0,20 п.п. — это до 20 потерянных покупок на 10 000 посетителей. До теста команда должна оценить их стоимость и убедиться, что экономия оправдывает такой допуск. В этом кейсе нижняя граница −0,131 выше предела: заранее согласованный критерий выполнен. Это основание обсудить выпуск более дешёвой формы, сохранив мониторинг ошибок и затрат."}]}],"$undefined"]}],["$","section",null,{"className":"work-takeaways","children":[["$","h3",null,{"children":"Что помнить на работе"}],["$","figure",null,{"className":"lesson-visual","children":[["$","div",null,{"className":"visual-title","children":"Как перейти от интервала к рабочему выводу"}],["$","div",null,{"className":"work-flow","children":["$L44","$L45","$L46"]}],"$L47"]}],"$L48","$L49"]}]]}]
