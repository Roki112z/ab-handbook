1c:["$","article","https://www.amstat.org/asa/files/pdfs/p-valuestatement.pdf",{"children":[["$","h2",null,{"children":["$","a",null,{"href":"https://www.amstat.org/asa/files/pdfs/p-valuestatement.pdf","target":"_blank","rel":"noopener noreferrer","children":["ASA Statement on Statistical Significance and P-Values"," ↗"]}]}],["$","p",null,{"children":"Что означает p-value, почему он не является вероятностью гипотезы и не измеряет размер или важность эффекта."}],["$","p",null,{"className":"source-detail","children":"Глава 3 · заявление ASA, 2016"}]]}]
