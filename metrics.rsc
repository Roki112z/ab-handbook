llic_fallback">группы</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.8804em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span>24:["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$35"}}]}],["$","figcaption",null,{"children":"Средний чек может вырасти из-за исчезновения недорогих заказов. Это не обещание роста выручки или прибыли на участника."}]]}]
25:["$","h3",null,{"children":"Почему нельзя просто выкинуть не купивших"}]
26:["$","p",null,{"children":"Назначение A/B было случайным среди подходящих людей. Но новая форма могла сама повлиять на покупку. Если после показа оставить только купивших, в двух группах могут остаться разные по свойствам люди. Для исходного вопроса о влиянии на всех участников такое ограничение меняет смысл сравнения."}]
27:["$","p",null,{"className":"note","children":"Отношения вроде среднего чека и доли кликов требуют отдельного расчёта неопределённости. При назначении по людям связанные заказы или показы одного человека нужно учитывать. Простая подстановка числа заказов в формулу SE независимых людей не подходит автоматически."}]
28:["$","aside",null,{"className":"work-note","aria-label":"На работе: Начните выгрузку с назначенных участников","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L20",null,{"ref":"$undefined","iconNode":"$13:props:children:0:props:children:0:props:iconNode","className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Начните выгрузку с назначенных участников"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Сначала получите список людей с вариантом и временем назначения. К нему присоедините события за одинаковое окно и сформируйте пользовательские итоги, в том числе нули. Для каждой итоговой метрики отдельно объясните, кто или что даёт вклад в числитель и знаменатель."}]}],"$undefined"]}]
