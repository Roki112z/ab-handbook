2c:T4be,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mtext>Мощность</mtext><mo>=</mo><mn>1</mn><mo>−</mo><mi>β</mi></mrow><annotation encoding="application/x-tex">\text{Мощность}=1-\beta</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:0.6833em;"></span><span class="mord text"><span class="mord cyrillic_fallback">Мощность</span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:0.7278em;vertical-align:-0.0833em;"></span><span class="mord">1</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right:0.2222em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:0.8889em;vertical-align:-0.1944em;"></span><span class="mord mathnormal" style="margin-right:0.0528em;">β</span></span></span></span></span>17:["$","$Lf",null,{"id":"rules","index":"03.3","title":"Ошибка относится ко всей процедуре","children":[["$","p",null,{"children":[["$","strong",null,{"children":"Ошибка I рода — ложная тревога:"}]," объявили разницу, хотя настоящего эффекта нет. ",["$","strong",null,{"children":"Ошибка II рода — пропуск:"}]," эффект есть, но данных не хватило его обнаружить. Вероятность пропуска обозначают β («бета»). ",["$","strong",null,{"children":"Мощность"}]," — вероятность обнаружить заданный настоящий эффект: 1 − β."]}],["$","figure",null,{"className":"lesson-visual","children":[["$","div",null,{"className":"visual-title","children":"Четыре возможных исхода одной проверки"}],["$","div",null,{"className":"error-matrix","children":[["$","div","В действительности Δ = 0Не отклонили H₀",{"className":"","children":[["$","span",null,{"children":"В действительности Δ = 0"}],["$","strong",null,{"children":"Не отклонили H₀"}],["$","small",null,{"children":[["$","$L2b",null,{"ref":"$undefined","iconNode":[["path",{"d":"M20 6 9 17l-5-5","key":"1gmf2c"}]],"className":"lucide-check","size":16}]," ","Ложной тревоги нет"]}]]}],["$","div","В действительности Δ = 0Отклонили H₀",{"className":"error-outcome","children":[["$","span",null,{"children":"В действительности Δ = 0"}],["$","strong",null,{"children":"Отклонили H₀"}],["$","small",null,{"children":[["$","$L2b",null,{"ref":"$undefined","iconNode":[["path",{"d":"M18 6 6 18","key":"1bl5f8"}],["path",{"d":"m6 6 12 12","key":"d8bk6v"}]],"className":"lucide-x","size":16}]," ","Ошибка I рода · α"]}]]}],["$","div","В действительности Δ ≠ 0Не отклонили H₀",{"className":"error-outcome","children":[["$","span",null,{"children":"В действительности Δ ≠ 0"}],["$","strong",null,{"children":"Не отклонили H₀"}],["$","small",null,{"children":[["$","$L2b",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:1:props:children:1:props:children:2:props:children:0:props:iconNode","className":"lucide-x","size":16}]," ","Ошибка II рода · β"]}]]}],["$","div","В действительности Δ ≠ 0Отклонили H₀",{"className":"","children":[["$","span",null,{"children":"В действительности Δ ≠ 0"}],["$","strong",null,{"children":"Отклонили H₀"}],["$","small",null,{"children":[["$","$L2b",null,{"ref":"$undefined","iconNode":"$17:props:children:1:props:children:1:props:children:0:props:children:2:props:children:0:props:iconNode","className":"lucide-check","size":16}]," ","Обнаружили эффект · мощность"]}]]}]]}],["$","figcaption",null,{"children":"α описывает частоту ошибки I рода при нулевом эффекте. β и мощность относятся к выбранному ненулевому эффекту и конкретному дизайну."}]]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$2c"}}]}],["$","figcaption",null,{"children":"Если процедура пропускает заданный ненулевой эффект в 20% повторов, β = 0,20, а мощность равна 80%. Это свойство процедуры при конкретном эффекте, а не вероятность успеха одного релиза."}]]}],"$L2d","$L2e","$L2f"]}]
