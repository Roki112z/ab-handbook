c-1 5-5 9-11 9h-2L532 67 19 159h-2c-5 0-9-4-11-9l-5-22c-1-6 2-12 8-13z"/></svg></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mord"><span class="mord">Δ</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3011em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">0</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.8133em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span>1:["$","$Lb",null,{"current":"p","children":[["$","section",null,{"className":"chapter-start","id":"start","children":[["$","div",null,{"className":"chapter-start-copy","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"chapter-pill","children":"03"}]," ","Следующий шаг"]}],["$","h1",null,{"children":"А если разница появилась случайно?"}],["$","p",null,{"children":"В прошлой главе мы получили диапазон возможных эффектов. Теперь зададим более узкий вопрос: насколько необычна наша разница, если новая страница покупки на самом деле ничего не меняет?"}],["$","p",null,{"children":"Это предположение называют нулевой гипотезой. Проверка гипотезы и p-value помогают сопоставить его с данными. Они не принимают за нас решение, стоит ли менять продукт."}],["$","div",null,{"className":"chapter-route","children":"Предположение → необычность данных → вывод"}]]}],["$","$Le",null,{"chapter":"p"}]]}],["$","nav",null,{"className":"lesson-toc","aria-label":"Разделы главы","children":[["$","a",null,{"href":"#null","children":"Нулевая гипотеза"}],["$","a",null,{"href":"#pvalue","children":"Смысл p-value"}],["$","a",null,{"href":"#errors","children":"Ошибки и мощность"}],["$","a",null,{"href":"#practice","children":"Практика"}],["$","a",null,{"href":"#real-salmon","children":"Опыт с лососем"}],["$","a",null,{"href":"#senior","children":"Учебный кейс"}]]}],["$","div",null,{"className":"play-shortcuts","children":[["$","span",null,{"children":"Новые задания"}],["$","a",null,{"href":"#coin-tails","children":"Монетка под подозрением"}],["$","a",null,{"href":"#metric-garden","children":"Двадцать проверок"}]]}],["$","$Lf",null,{"id":"null","index":"03.1","title":"Зададим конкретный вопрос","children":[["$","p",null,{"children":["Предположим, новая форма покупки в среднем ничего не меняет. Это наша ",["$","strong",null,{"children":"нулевая гипотеза"}],", H₀ («аш нулевое»). Δ = 0 означает, что настоящая разница равна нулю. Альтернатива H₁: Δ ≠ 0 — разница есть. Проверка называется ",["$","strong",null,{"children":"двусторонней"}],", потому что нас интересует и рост, и снижение."]}],["$","p",null,{"children":["До запуска договариваемся, что измерять, для каких людей и сколько дней. Также выбираем порог решения — ",["$","strong",null,{"children":"уровень значимости α"}]," («альфа»). Здесь α = 0,05: при отсутствии эффекта корректная процедура ошибочно объявляла бы различие примерно в 5% повторов. Это характеристика правила, а не вероятность ошибиться в данном запуске."]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$10"}}]}],"$L11"]}],"$L12","$L13","$L14"]}],"$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]
