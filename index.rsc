"$","small",null,{"children":"комиссия"}]]}]]}]]]}],["$","div",null,{"children":[["$","h4",null,{"children":"Другая группа получила B"}],[["$","div",null,{"className":"market-guest","children":[["$","$L10",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:9:props:children:0:props:children:0:props:children:1:0:props:children:0:props:iconNode","className":"lucide-search","size":17,"aria-hidden":"true"}]," Один гость сравнивает эти варианты"]}],["$","div",null,{"className":"market-connectors","aria-hidden":"true","children":[["$","i",null,{}],["$","i",null,{}],["$","i",null,{}]]}],["$","div",null,{"className":"market-listings","children":[["$","div","0-B",{"className":"market-listing variant-b","children":[["$","$L10",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:9:props:children:0:props:children:0:props:children:1:2:props:children:0:props:children:0:props:iconNode","className":"lucide-house","size":23,"aria-hidden":"true"}],["$","span",null,{"children":"Выше"}],["$","small",null,{"children":"комиссия"}]]}],["$","div","1-B",{"className":"market-listing variant-b","children":[["$","$L10",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:9:props:children:0:props:children:0:props:children:1:2:props:children:0:props:children:0:props:iconNode","className":"lucide-house","size":23,"aria-hidden":"true"}],["$","span",null,{"children":"Выше"}],["$","small",null,{"children":"комиссия"}]]}],["$","div","2-B",{"className":"market-listing variant-b","children":[["$","$L10",null,{"ref":"$undefined","iconNode":"$27:props:children:1:props:children:9:props:children:0:props:children:0:props:children:1:2:props:children:0:props:children:0:props:iconNode","className":"lucide-house","size":23,"aria-hidden":"true"}],["$","span",null,{"children":"Выше"}],["$","small",null,{"children":"комиссия"}]]}]]}]]]}]]}],["$","p",null,{"children":"Сначала объединяют объявления, которые гости часто рассматривают как замену друг другу.