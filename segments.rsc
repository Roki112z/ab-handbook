12:["$","aside",null,{"className":"work-note","aria-label":"На работе: Начните с решения, которое изменится","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L1f",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 12h.01","key":"1mp3jc"}],["path",{"d":"M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2","key":"1ksdt3"}],["path",{"d":"M22 13a18.15 18.15 0 0 1-20 0","key":"12hx5q"}],["rect",{"width":"20","height":"14","x":"2","y":"6","rx":"2","key":"i6l2r4"}]],"className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Начните с решения, которое изменится"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Запишите: «Если новая форма помогает новичкам достаточно сильно и не ухудшает оплату, сможем включить её только для них». Так станет ясно, какой сегмент нужен, какая польза достаточна и на что тратить выборку. Десятки срезов без предполагаемого действия обычно создают больше вопросов, чем ответов."}]}],"$undefined"]}]
13:["$","$L10",null,{"id":"segment-population","index":"08.2","title":"Признак сегмента фиксируем до воздействия","children":[["$","p",null,{"children":"«До теста ещё не покупал» и «не купил во время теста» — разные признаки. Первый уже существует при назначении. Второй может измениться из-за новой формы. Если B помогает купить, часть людей покинет сегмент «не купившие» именно благодаря изменению."}],["$","div",null,{"className":"before-after-rule","children":[["$","div",null,{"children":[["$","span",null,{"children":"До назначения"}],["$","strong",null,{"children":"Был новичком → остаётся в сегменте новичков"}],["$","p",null,{"children":"Можно изучать, как B повлиял на эту аудиторию."}]]}],["$","div",null,{"children":[["$","span",null,{"children":"После назначения"}],["$","strong",null,{"children":"Купил из-за B → попал в отобранную группу"}],["$","p",null,{"children":"Само воздействие влияет на то, кого мы сравниваем."}]]}]]}],["$","p",null,{"children":"Например, сравнение среднего чека только у купивших описывает выбранных покупателей. Оно не отвечает автоматически на вопрос, сколько денег новая форма приносит на исходного участника. Эту ловушку мы уже видели в главе о метриках."}],["$","aside",null,{"className":"work-note","aria-label":"На работе: Добавьте дату к определению сегмента","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L1f",null,{"ref":"$undefined","iconNode":"$12:props:children:0:props:children:0:props:iconNode","className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Добавьте дату к определению сегмента"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Вместо «новые пользователи» напишите «на момент назначения нет успешных покупок за всю доступную историю». Укажите, как учитываются неизвестные старые аккаунты. Сохраните признак вместе с назначением и применяйте одинаковое правило в A и B."}]}],"$undefined"]}]]}]
