1:["$","$Lc",null,{"current":"segments","children":[["$","section",null,{"className":"chapter-start","id":"start","children":[["$","div",null,{"className":"chapter-start-copy","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"chapter-pill","children":"08"}]," ","Следующий шаг"]}],["$","h1",null,{"children":"Для кого сработало изменение?"}],["$","p",null,{"children":"В среднем новая форма немного помогает покупать. Но новичкам и постоянным покупателям она может быть полезна по-разному. Как узнать, кому её стоит показывать, и не принять случайную находку за открытие?"}],["$","p",null,{"children":"Разделим аудиторию на понятные группы, посмотрим, как их состав меняет общий итог, и научимся сравнивать эффекты напрямую."}],["$","div",null,{"className":"chapter-route","children":"Аудитория → состав → сравнение эффектов → решение"}]]}],["$","$Lf",null,{"chapter":"segments"}]]}],["$","nav",null,{"className":"lesson-toc","aria-label":"Разделы главы","children":[["$","a",null,{"href":"#segment-question","children":"Зачем нужны сегменты"}],["$","a",null,{"href":"#segment-mix","children":"Общий результат"}],["$","a",null,{"href":"#segment-compare","children":"Сравнение эффектов"}],["$","a",null,{"href":"#real-simpson","children":"История Microsoft"}],["$","a",null,{"href":"#segment-work","children":"План для команды"}]]}],["$","div",null,{"className":"play-shortcuts","children":[["$","span",null,{"children":"Лаборатории по теме"}],["$","a",null,{"href":"#cohort-lab","children":"Кого сравнивать"}],["$","a",null,{"href":"#mixture-lab","children":"Смешать аудиторию"}],["$","a",null,{"href":"#interaction-lab","children":"Разные ли эффекты"}]]}],["$","$L10",null,{"id":"segment-question","index":"08.1","title":"Среднее отвечает не на каждый вопрос","children":[["$","p",null,{"children":"Магазин сократил форму заказа. В среднем покупок стало чуть больше. Но команда предполагает: новичкам стало проще разобраться, а постоянным покупателям форма и раньше не мешала. Стоит ли показывать её всем или только новичкам?"}],["$","p",null,{"children":[["$","strong",null,{"children":"Сегмент — часть аудитории с общим признаком."}]," Например, люди без прошлых покупок, владельцы Android или жители определённой страны. Сегмент — не вариант теста: и среди новичков, и среди вернувшихся есть свои A и B."]}],["$","figure",null,{"className":"lesson-visual","children":[["$","div",null,{"className":"segment-map","children":[["$","article",null,{"children":[["$","span",null,{"children":"Новички до начала теста"}],["$","div",null,{"children":[["$","b",null,{"children":"A · старая форма"}],["$","b",null,{"children":"B · новая форма"}]]}],["$","strong",null,{"children":"Сравниваем A и B внутри новичков"}]]}],["$","article",null,{"children":[["$","span",null,{"children":"Уже покупали до теста"}],["$","div",null,{"children":[["$","b",null,{"children":"A · старая форма"}],["$","b",null,{"children":"B · новая форма"}]]}],["$","strong",null,{"children":"Сравниваем A и B внутри вернувшихся"}]]}]]}],["$","figcaption",null,{"children":"Сначала получаем эффект внутри каждого сегмента. Затем задаём отдельный вопрос: насколько эти эффекты отличаются друг от друга?"}]]}],["$","p",null,{"children":"Это полезно для решения о доступности функции, локализации или поддержке устройств. Но маленькие сегменты дают менее точные оценки, а множество попыток найти «победителя» повышает риск случайной находки. Поэтому конкретный рабочий вопрос лучше сформулировать до просмотра результатов."}],["$","$L11",null,{"id":"segment-definition","question":"Как проверить пользу новой формы для новичков?","options":["Сравнить новичков B с постоянными покупателями A","Сравнить новичков A с новичками B, определив новичка до воздействия","Оставить только тех новичков, кто купил после показа формы"],"correct":1,"explanation":"Нужны обе случайно назначенные версии внутри одной заранее определённой аудитории. У новичков и постоянных покупателей и без новой формы разная вероятность покупки; их прямое сравнение смешает особенности людей с эффектом функции."}],"$L12"]}],"$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]}]
