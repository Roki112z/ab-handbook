c-1 5-5 9-11 9h-2L532 67 19 159h-2c-5 0-9-4-11-9l-5-22c-1-6 2-12 8-13z"/></svg></span></span></span></span></span></span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.1514em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord text mtight"><span class="mord cyrillic_fallback mtight">вер</span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.2861em;"><span></span></span></span></span></span></span></span></span></span></span>17:["$","$L10",null,{"id":"segment-compare","index":"08.4","title":"«Значимо только у новичков» ещё не означает «помогает только им»","children":[["$","p",null,{"children":"Представим: у новичков оценка +1 п.п. с узким интервалом, у вернувшихся тоже +1 п.п., но интервал шире. В первом сегменте p меньше 0,05, во втором больше. Оценки эффектов одинаковые — отличается объём информации."}],["$","section",null,{"className":"reading-compare","aria-label":"Польза внутри сегмента и разница между сегментами","children":[["$","div","Внутри одной аудитории",{"children":[["$","span",null,{"className":"reading-compare-label","children":"Внутри одной аудитории"}],["$","h3",null,{"children":"Эффект отличается от нуля?"}],["$","p",null,{"children":"Отдельное p новичков и отдельное p вернувшихся отвечают на этот вопрос для каждой группы."}]]}],["$","div","Между аудиториями",{"children":[["$","span",null,{"className":"reading-compare-label","children":"Между аудиториями"}],["$","h3",null,{"children":"Эффекты отличаются друг от друга?"}],["$","p",null,{"children":"Нужна прямая проверка разности эффектов. Её часто называют проверкой взаимодействия."}]]}]]}],["$","aside",null,{"className":"reading-key","children":[["$","span",null,{"children":"Главная мысль"}],["$","p",null,{"children":"Два одинаковых эффекта могут иметь разные p-value из-за разной точности. Одно «значимо», другое «не значимо» ещё не доказывает различие эффектов."}]]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$27"}}]}],"$L28"]}],"$L29","$L2a","$L2b","$L2c"]}]
