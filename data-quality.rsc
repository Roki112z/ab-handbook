1:["$","$Lb",null,{"current":"trust","children":[["$","section",null,{"className":"chapter-start","id":"start","children":[["$","div",null,{"className":"chapter-start-copy","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"chapter-pill","children":"07"}]," ","Следующий шаг"]}],["$","h1",null,{"children":"Можно ли доверять этому отчёту?"}],["$","p",null,{"children":"В отчёте выросла конверсия. Но что, если из новой версии просто потерялись не купившие люди? Хорошее число ещё не означает, что изменение помогло."}],["$","p",null,{"children":"Проверим путь от назначения до отчёта. Разберём A/A, пропорции групп и качество событий. Научимся объяснять команде, когда вывод о продукте нужно отложить."}],["$","div",null,{"className":"chapter-route","children":"Назначение → события → проверки → доверие"}]]}],["$","$Le",null,{"chapter":"trust"}]]}],["$","nav",null,{"className":"lesson-toc","aria-label":"Разделы главы","children":[["$","a",null,{"href":"#trust-start","children":"Почему сначала данные"}],["$","a",null,{"href":"#aa","children":"A/A"}],["$","a",null,{"href":"#srm","children":"SRM"}],["$","a",null,{"href":"#invariants","children":"Другие проверки"}],["$","a",null,{"href":"#real-srm","children":"История Microsoft"}],["$","a",null,{"href":"#trust-work","children":"Порядок действий"}]]}],["$","div",null,{"className":"play-shortcuts","children":[["$","span",null,{"children":"Лаборатории по теме"}],["$","a",null,{"href":"#aa-lab","children":"Измерительный прибор"}],["$","a",null,{"href":"#srm-lab","children":"53 на 47"}],["$","a",null,{"href":"#trace-lab","children":"Куда пропали участники"}]]}],["$","$Lf",null,{"id":"trust-start","index":"07.1","title":"Хорошее число может получиться из плохих данных","children":[["$","p",null,{"children":["Магазин тестирует новую форму. В отчёте конверсия B выше. Прежде чем обсуждать выпуск, спросим: ",["$","strong",null,{"children":"в отчёте остались те люди, которых мы назначили, и правильно ли записались их покупки?"}]]}],["$","p",null,{"children":"Рассмотрим учебную поломку. В A и B назначили по 1 000 человек, в каждой группе купили 100. Но из B при обработке исчезли 200 не купивших. В итоговой таблице B выглядит лучше, хотя число покупок и исходная конверсия одинаковые."}],["$","figure",null,{"className":"lesson-visual","children":[["$","h3",null,{"children":"Одна потеря меняет историю"}],["$","div",null,{"className":"data-loss-example","children":[["$","div",null,{"children":[["$","span",null,{"children":"До потери"}],["$","strong",null,{"children":"A: 100 / 1 000 = 10%"}],["$","strong",null,{"children":"B: 100 / 1 000 = 10%"}]]}],["$","div",null,{"children":[["$","span",null,{"children":"В повреждённом отчёте"}],["$","strong",null,{"children":"A: 100 / 1 000 = 10%"}],["$","strong",null,{"children":"B: 100 / 800 = 12,5%"}]]}]]}],["$","figcaption",null,{"children":"Учебные числа. Видимые +2,5 п.п. созданы потерей не купивших в B, а не новой формой."}]]}],["$","p",null,{"children":["Формула доверительного интервала может быть реализована без ошибок и всё равно не отвечать на исходный вопрос: она получила не ту выборку. Поэтому порядок чтения отчёта такой: ",["$","strong",null,{"children":"качество данных → эффект и интервал → бизнес-решение"}],"."]}],["$","aside",null,{"className":"work-note","aria-label":"На работе: Начинайте встречу с короткой проверки доверия","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L10",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 12h.01","key":"1mp3jc"}],["path",{"d":"M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2","key":"1ksdt3"}],["path",{"d":"M22 13a18.15 18.15 0 0 1-20 0","key":"12hx5q"}],["rect",{"width":"20","height":"14","x":"2","y":"6","rx":"2","key":"i6l2r4"}]],"className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Начинайте встречу с короткой проверки доверия"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Покажите план назначения, число участников на ключевых этапах, полноту событий и готовность окон. Если критическая проверка не пройдена, прямо напишите, какой вывод пока запрещён и что нужно выяснить."}]}],"$undefined"]}]]}],["$","$Lf",null,{"id":"aa","index":"07.2","title":"A/A: сравниваем одинаковое, проверяем процедуру","children":["$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22"]}]
