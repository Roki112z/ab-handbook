3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"План теста: MDE, мощность и выборка · A/B handbook"}],["$","meta","1",{"name":"description","content":"Пять интерактивных глав по A/B-тестированию: SD, SE, интервалы, p-value, планирование выборки и выбор метрик. Простые объяснения, лаборатории и рабочие примеры."}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/ab-handbook/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["planning"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"planning","fallback":["$","$Lb",null,{"children":["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"Такой главы пока нет."}],["$","p",null,{"children":"Вернитесь к оглавлению и выберите одну из трёх глав."}],["$","a",null,{"href":"/ab-handbook/contents","className":"primary-button","style":{"marginTop":24},"children":"Открыть оглавление"}]]}]}],"children":["$","$La",null,{"resetKey":"[\"planning\"]","fallback":["$","$Lb",null,{"children":["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"Такой главы пока нет."}],["$","p",null,{"children":"Вернитесь к оглавлению и выберите одну из трёх глав."}],["$","a",null,{"href":"/ab-handbook/contents","className":"primary-button","style":{"marginTop":24},"children":"Открыть оглавление"}]]}]}],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L8",null,{"providerId":"page:/planning/","segmentMap":{"children":["__PAGE__"]