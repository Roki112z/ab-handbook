><span class="pstrut" style="height:3.054em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.7992em;"><span class="pstrut" style="height:3.054em;"></span><span class="mord"><span class="mord">2</span><span class="mord"><span class="mord mathnormal">p</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3011em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">0</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mopen">(</span><span class="mord">1</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">−</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mord"><span class="mord mathnormal">p</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3011em;"><span style="top:-2.55em;margin-left:0em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">0</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.15em;"><span></span></span></span></span></span></span><span class="mclose">)</span><span class="mspace" style="margin-right:0.1667em;"></span><span class="minner"><span class="minner"><span class="mopen delimcenter" style="top:0em;"><span class="delimsizing size1">(</span></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.044em;">z</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3448em;"><span style="top:-2.5198em;margin-left:-0.044em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight">1</span><span class="mbin mtight">−</span><span class="mord mathnormal mtight" style="margin-right:0.0037em;">α</span><span class="mord mtight">/2</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.3552em;"><span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">+</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.044em;">z</span><span class="msupsub"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:0.3361em;"><span style="top:-2.55em;margin-left:-0.044em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight"><span class="mord mtight">1</span><span class="mbin mtight">−</span><span class="mord mathnormal mtight" style="margin-right:0.0528em;">β</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.2861em;"><span></span></span></span></span></span></span><span class="mclose delimcenter" style="top:0em;"><span class="delimsizing size1">)</span></span></span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height:1.054em;"><span style="top:-3.3029em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mord mtight">2</span></span></span></span></span></span></span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.686em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span>14:["$","$Lf",null,{"id":"sample-size-plan","index":"04.3","title":"От нужной чувствительности к числу людей","children":[["$","p",null,{"children":"В первой главе мы узнали: SE уменьшается примерно как обратный квадратный корень из объёма. Поэтому тонкую разницу отделить от шума дороже. Если хотим обнаруживать вдвое меньший эффект с той же мощностью, обычно нужно примерно вчетверо больше независимых участников."}],["$","figure",null,{"className":"lesson-visual","children":[["$","h3",null,{"children":"Цена маленького MDE"}],["$","div",null,{"className":"sample-cost-ladder","children":[["$","div","0.8",{"children":[["$","span",null,{"children":["+","0,8"," п.п."]}],["$","i",null,{"style":{"width":"6.250194745169455%"}}],["$","b",null,{"children":"18 053"}]]}],["$","div","0.4",{"children":[["$","span",null,{"children":["+","0,4"," п.п."]}],["$","i",null,{"style":{"width":"25.000086553408646%"}}],["$","b",null,{"children":"72 210"}]]}],["$","div","0.2",{"children":[["$","span",null,{"children":["+","0,2"," п.п."]}],["$","i",null,{"style":{"width":"100%"}}],["$","b",null,{"children":"288 839"}]]}]]}],["$","figcaption",null,{"children":["Число людей ",["$","strong",null,{"children":"на одну группу"}],": база 8%, мощность 80%, α = 5%, независимые A и B. Это приближённый расчёт, одинаковый с планировщиком ниже."]}]]}],["$","h3",null,{"children":"Разберём формулу без требования её запоминать"}],["$","p",null,{"children":["Для двух равных независимых групп можно получить простой ориентир. В обеих группах приближённо используем исходную дисперсию покупки p₀(1 − p₀). Здесь p₀ — вероятность покупки до изменения, а δ («дельта») — запланированный эффект ",["$","strong",null,{"children":"в долях, не в п.п."}]]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$21"}}]}],"$L22"]}],"$L23","$L24","$L25","$L26","$L27"]}]
28:Tad2,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mtext>Дней набора</mtext><mo>≈</mo><mfrac><mrow><mn>2</mn><mi>n</mi></mrow><mrow><mtext>новых подходящих людей в день</mtext><mo>×</mo><mtext>доля трафика</mtext></mrow></mfrac></mrow><annotation encoding="application/x-tex">\text{Дней набора}\approx\frac{2n}{\text{новых подходящих людей в день}\times\text{доля трафика}}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:0.8889em;vertical-align:-0.1944em;"></span><span class="mord text"><span class="mord cyrillic_fallback">Дней</span><span class="mord"> </span><span class="mord cyrillic_fallback">набора</span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">≈</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:2.2019em;vertical-align:-0.8804em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.3214em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord text"><span class="mord cyrillic_fallback">новых</span><span class="mord"> </span><span class="mord cyrillic_fallback">подходящих</span><span class="mord"> </span><span class="mord cyrillic_fallback">людей</span><span class="mord"> </span><span class="mord cyrillic_fallback">в</span><span class="mord"> </span><span class="mord cyrillic_fallback">день</span></span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mbin">×</span><span class="mspace" style="margin-right:0.2222em;"></span><span class="mord text"><span class="mord cyrillic_fallback">доля</span><span class="mord"> </span><span class="mord cyrillic_fallback">трафика</span></span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord">2</span><span class="mord mathnormal">n</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.8804em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span>15:["$","$Lf",null,{"id":"duration","index":"04.4","title":"Число людей ещё не дата готового ответа","children":[["$","p",null,{"children":["Пусть в магазин каждый день впервые приходят 20 000 подходящих для теста людей. Половину этого потока выделили на эксперимент A + B. Между вариантами делим поровну: ",["$","strong",null,{"children":"по 5 000 новых участников в день"}],"."]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$28"}}]}],["$","figcaption",null,{"children":"При n = 72 210, потоке 20 000 и доле 0,5 нужно около 14,44 дня. Округляем вверх: не меньше 15 дней набора при постоянном потоке."}]]}],"$L29","$L2a","$L2b","$L2c"]}]
