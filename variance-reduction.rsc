3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Повышение точности: прошлые данные и CUPED · A/B handbook"}],["$","meta","1",{"name":"description","content":"Девять интерактивных глав по A/B-тестированию: статистика, планирование, метрики, дизайн, качество данных, сегменты и CUPED. Простые объяснения, лаборатории и рабочие примеры."}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/ab-handbook/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["variance-reduction"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"variance-reduction","fallback":["$","$Lb",null,{"children":["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"Такой главы пока нет."}],["$","p",null,{"children":"Вернитесь к оглавлению и выберите одну из трёх глав."}],["$","a",null,{"href":"/ab-handbook/contents","className":"primary-button","style":{"marginTop":24},"children":"Открыть оглавление"}]]}]}],"children":["$","$La",null,{"resetKey":"[\"variance-reduction\"]","fallback":["$","$Lb",null,{"children":["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"Такой главы пока нет."}],["$","p",null,{"children":"Вернитесь к оглавлению и выберите одну из трёх глав."}],["$","a",null,{"href":"/ab-handbook/contents","className":"primary-button","style":{"marginTop":24},"children":"Открыть оглавление"}]]}]}],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L8",null,{"providerId":"pa