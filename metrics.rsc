22:Ta88,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><mtext>Выручка на участника</mtext><mo>=</mo><mfrac><mtext>суммарная выручка группы</mtext><mtext>все назначенные участники группы</mtext></mfrac></mrow><annotation encoding="application/x-tex">\text{Выручка на участника}=\frac{\text{суммарная выручка группы}}{\text{все назначенные участники группы}}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:0.8778em;vertical-align:-0.1944em;"></span><span class="mord text"><span class="mord cyrillic_fallback">Выручка</span><span class="mord"> </span><span class="mord cyrillic_fallback">на</span><span class="mord"> </span><span class="mord cyrillic_fallback">участника</span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:1.988em;vertical-align:-0.8804em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.1076em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord text"><span class="mord cyrillic_fallback">все</span><span class="mord"> </span><span class="mord cyrillic_fallback">назначенные</span><span class="mord"> </span><span class="mord cyrillic_fallback">участники</span><span class="mord"> </span><span class="mord cyrillic_fallback">группы</span></span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mord text"><span class="mord cyrillic_fallback">суммарная</span><span class="mord"> </span><span class="mord cyrillic_fallback">выручка</span><span class="mord"> </span><span class="mord cyrillic_fallback">группы</span></span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.8804em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span>16:["$","$L10",null,{"id":"metric-unit","index":"05.3","title":"Одна строка — человек, заказ или показ?","children":[["$","p",null,{"children":"Слово «средний» не определяет метрику полностью. Средняя выручка на человека и средняя выручка на заказ отвечают на разные вопросы. Из первой главы вы помните: много записей одного человека не превращаются в много независимых участников."}],["$","div",null,{"className":"metric-types","children":[["$","article",null,{"children":[["$","strong",null,{"children":"Доля"}],["$","p",null,{"children":"Купил хотя бы раз: 0 или 1 на человека. Среднее этих значений — конверсия."}]]}],["$","article",null,{"children":[["$","strong",null,{"children":"Среднее на участника"}],["$","p",null,{"children":"Сумма его выручки за 7 дней; у не купившего — 0. Затем усредняем по людям."}]]}],["$","article",null,{"children":[["$","strong",null,{"children":"Отношение сумм"}],["$","p",null,{"children":"Общая выручка / число заказов — средний чек. Его знаменатель может измениться из-за новой формы."}]]}]]}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$22"}}]}],"$L23"]}],"$L24","$L25","$L26","$L27","$L28"]}]
