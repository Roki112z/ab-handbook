c-1 5-5 9-11 9h-2L532 67 19 159h-2c-5 0-9-4-11-9l-5-22c-1-6 2-12 8-13z"/></svg></span></span></span></span></span></span></span></span></span></span>1:["$","$Lb",null,{"current":"ci","children":[["$","section",null,{"className":"chapter-start","id":"start","children":[["$","div",null,{"className":"chapter-start-copy","children":[["$","div",null,{"className":"eyebrow","children":[["$","span",null,{"className":"chapter-pill","children":"02"}]," ","Следующий шаг"]}],["$","h1",null,{"children":"Насколько точен наш результат?"}],["$","p",null,{"children":"В магазине проверили новую страницу оформления заказа. Доля купивших выросла с 10% до 10,4%. Это +0,4 процентного пункта. Но из первой главы мы знаем: другая случайная группа людей могла дать другое число."}],["$","p",null,{"children":"Теперь вместо одной оценки построим диапазон. Он поможет понять: данные допускают только рост или также небольшое снижение? Доверительный интервал сокращают как ДИ или CI — от confidence interval."}],["$","div",null,{"className":"chapter-route","children":"Оценка → границы диапазона → решение"}]]}],["$","$Le",null,{"chapter":"ci"}]]}],["$","nav",null,{"className":"lesson-toc","aria-label":"Разделы главы","children":[["$","a",null,{"href":"#interval","children":"Построение интервала"}],["$","a",null,{"href":"#meaning","children":"Смысл 95%"}],["$","a",null,{"href":"#decision","children":"Продуктовое решение"}],["$","a",null,{"href":"#practice","children":"Практика"}],["$","a",null,{"href":"#real-ebay","children":"История eBay"}],["$","a",null,{"href":"#senior","children":"Учебный кейс"}]]}],["$","div",null,{"className":"play-shortcuts","children":[["$","span",null,{"children":"Лаборатории по теме"}],["$","a",null,{"href":"#interval-builder","children":"Собрать интервал"}],["$","a",null,{"href":"#interval-verdicts","children":"Выбрать вывод для команды"}]]}],["$","$Lf",null,{"id":"interval","index":"02.1","title":"Как из SE получить диапазон","children":[["$","p",null,{"children":["В тесте старой и новой форм покупки получили ",["$","strong",null,{"children":"+0,4 п.п."}]," при SE примерно ",["$","strong",null,{"children":"0,271 п.п."}]," SE описывает масштаб случайных колебаний. Теперь превратим её в понятные границы вокруг оценки."]}],["$","aside",null,{"className":"reading-key","children":[["$","span",null,{"children":"Доверительный интервал"}],["$","p",null,{"children":"Отрезок от нижней до верхней границы. Здесь он получится примерно от −0,13 до +0,93 п.п.: данные допускают небольшое снижение, отсутствие изменения и рост."}]]}],["$","p",null,{"children":"Для используемого здесь метода берём оценку и откладываем запас в обе стороны. Запас зависит от SE: чем сильнее колеблются оценки, тем шире нужен диапазон."}],["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$10"}}]}],"$L11"]}],"$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a"]}],"$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24"]}]
