3:[[["$","meta",null,{"charSet":"utf-8"}],[["$","title","0",{"children":"Словарь простыми словами · A/B handbook"}],["$","meta","1",{"name":"description","content":"Девять интерактивных глав по A/B-тестированию: статистика, планирование, метрики, дизайн, качество данных, сегменты и CUPED. Простые объяснения, лаборатории и рабочие примеры."}],["$","link","2",{"data-vinext-streamed-icon":"$undefined","rel":"icon","href":"/ab-handbook/favicon.svg","type":"$undefined","sizes":"$undefined","color":"$undefined","media":"$undefined","fetchPriority":"$undefined"}]],[["$","meta","0",{"name":"viewport","content":"width=device-width, initial-scale=1"}]]],["$","$L5",null,{"fallback":"$6","children":["$","$L7",null,{"fallback":"$6","children":["$","$L8",null,{"providerId":"layout:/","segmentMap":{"children":["glossary"]},"children":["$","$L9",null,{"id":"layout:/","parallelSlots":"$undefined","children":["$","$La",null,{"resetKey":"glossary","fallback":["$","$Lb",null,{"children":["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"Такой главы пока нет."}],["$","p",null,{"children":"Вернитесь к оглавлению и выберите одну из трёх глав."}],["$","a",null,{"href":"/ab-handbook/contents","className":"primary-button","style":{"marginTop":24},"children":"Открыть оглавление"}]]}]}],"children":["$","$La",null,{"resetKey":"[\"glossary\"]","fallback":["$","$Lb",null,{"children":["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":"404"}],["$","h1",null,{"children":"Такой главы пока нет."}],["$","p",null,{"children":"Вернитесь к оглавлению и выберите одну из трёх глав."}],["$","a",null,{"href":"/ab-handbook/contents","className":"primary-button","style":{"marginTop":24},"children":"Открыть оглавление"}]]}]}],"children":["$","$Lc",null,{"children":["$","$Ld",null,{"children":[["$","$L8",null,{"providerId":"page:/glossary/","segmentMap":{"children":["__PAGE__"]},"children":["$","$L9",null,{"id":"page:/glossary/"}]}],null]}]}]}]}]}]}]}]}],null,null]
1:["$","$Lb",null,{"children":[["$","div",null,{"className":"page-intro","children":[["$","div",null,{"className":"eyebrow","children":["Справочник / понятий: ",60]}],["$","h1",null,{"children":"Простые слова для новых понятий."}],["$","p",null,{"children":"Определение, пример и смысл для эксперимента. Термины расположены примерно в порядке знакомства с ними в курсе."}]]}],["$","dl",null,{"className":"reference-list","children":[["$","div","A/B-тест",{"children":[["$","dt",null,{"children":"A/B-тест"}],["$","dd",null,{"children":"Сравнение двух вариантов в одинаковый период. Например, случайно выбранные посетители видят старую или новую форму покупки. Затем сравнивают выбранный показатель."}]]}],["$","div","Контроль и тест",{"children":[["$","dt",null,{"children":"Контроль и тест"}],["$","dd",null,{"children":"Контроль A — вариант, с которым сравниваем, обычно прежняя версия. Тест B — вариант с изменением."}]]}],["$","div","Оформление заказа / checkout",{"children":[["$","dt",null,{"children":"Оформление заказа / checkout"}],["$","dd",null,{"children":"Шаги перед покупкой: ввести адрес, выбрать доставку и оплатить. В примере курса мы меняем эту форму."}]]}],["$","div","Метрика",{"children":[["$","dt",null,{"children":"Метрика"}],["$","dd",null,{"children":"Число, по которому оцениваем результат: доля покупателей, среднее время ожидания, выручка. До теста выбираем, что именно измерять."}]]}],["$","div","Конверсия",{"children":[["$","dt",null,{"children":"Конверсия"}],["$","dd",null,{"children":"Доля людей, совершивших нужное действие. Купили 10 из 100 — конверсия 10%. Важно одинаково определить участников и срок, за который считаем покупку."}]]}],["$","div","Процентный пункт, п.п.",{"children":[["$","dt",null,{"children":"Процентный пункт, п.п."}],["$","dd",null,{"children":"Единица разницы двух процентов. Рост с 10% до 10,4% — это +0,4 п.п. Относительный рост самой конверсии равен 0,4 / 10 × 100% = 4%."}]]}],["$","div","Выборка",{"children":[["$","dt",null,{"children":"Выборка"}],["$","dd",null,{"children":"Те люди или наблюдения, которые мы собрали для исследования. Например, 25 000 участников одной группы теста."}]]}],["$","div","Среднее",{"children":[["$","dt",null,{"children":"Среднее"}],["$","dd",null,{"children":"Сумма значений, делённая на их количество. Для 2, 10 и 18 минут среднее равно (2 + 10 + 18) / 3 = 10 минут."}]]}],["$","div","Стандартное отклонение, SD",{"children":[["$","dt",null,{"children":"Стандартное отклонение, SD"}],["$","dd",null,{"children":"Число, описывающее разброс отдельных значений вокруг их среднего. У людей со временем ожидания 2, 10 и 18 минут разброс больше, чем у людей с 9, 10 и 11 минутами, хотя среднее одинаковое. SD выражается в минутах, а не в процентах ошибки."}]]}],["$","div","Дисперсия",{"children":[["$","dt",null,{"children":"Дисперсия"}],["$","dd",null,{"children":"Мера разброса в квадрате исходных единиц. SD — квадратный корень из дисперсии. Дисперсии 64 мин² соответствует SD = 8 минут."}]]}],["$","div","Оценка эффекта, Δ̂",{"children":[["$","dt",null,{"children":"Оценка эффекта, Δ̂"}],["$","dd",null,{"children":"Разница, рассчитанная по данным конкретного теста. Например, наблюдаемая конверсия B минус конверсия A. При новом случайном составе групп число может измениться."}]]}],["$","div","Настоящий эффект, Δ",{"children":[["$","dt",null,{"children":"Настоящий эффект, Δ"}],["$","dd",null,{"children":"Разница, которую изменение в среднем создаёт у выбранных пользователей за выбранный срок. В реальном тесте она неизвестна: мы пытаемся узнать её по данным."}]]}],["$","div","Распределение оценок",{"children":[["$","dt",null,{"children":"Распределение оценок"}],["$","dd",null,{"children":"Какие оценки и как часто получались бы при многократном повторении такого же исследования. На графике повторов одна оценка относится к целому запуску, а не одному человеку."}]]}],["$","div","Стандартная ошибка, SE",{"children":[["$","dt",null,{"children":"Стандартная ошибка, SE"}],"$Le"]}],"$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c"]}]]}]
e:["$","dd",null,{"children":"Масштаб колебаний оценки между повторениями исследования. SD говорит о разбросе людей, а SE среднего — о разбросе средних. Для независимых наблюдений SE среднего оценивают как SD / √n."}]
f:["$","div","Рандомизация",{"children":[["$","dt",null,{"children":"Рандомизация"}],["$","dd",null,{"children":"Случайное назначение варианта, похожее на подбрасывание монетки. Помогает не отбирать в один вариант людей с особыми свойствами, например самых активных покупателей."}]]}]
10:["$","div","Единица рандомизации",{"children":[["$","dt",null,{"children":"Единица рандомизации"}],["$","dd",null,{"children":"То, чему назначают вариант целиком: человек, объявление, группа объявлений или город на один час. Строка таблицы и единица назначения могут не совпадать."}]]}]
11:["$","div","Независимость наблюдений",{"children":[["$","dt",null,{"children":"Независимость наблюдений"}],["$","dd",null,{"children":"Свойство модели, в которой знание одного наблюдения не меняет распределение другого. Общая поломка, задержавшая несколько заказов, может создать зависимость между их временами доставки."}]]}]
12:["$","div","Кластер",{"children":[["$","dt",null,{"children":"Кластер"}],["$","dd",null,{"children":"Группа объектов, которую рассматривают вместе. В истории Airbnb похожим объявлениям назначали общий вариант. Это помогает учесть, что они конкурируют за одних гостей."}]]}]
13:["$","div","Смещение оценки",{"children":[["$","dt",null,{"children":"Смещение оценки"}],["$","dd",null,{"children":"Систематическое отклонение от величины, которую хотим узнать. Если причина смещения сохраняется, большое количество данных может дать очень точную оценку неправильной величины."}]]}]
14:["$","div","Доверительный интервал, CI / ДИ",{"children":[["$","dt",null,{"children":"Доверительный интервал, CI / ДИ"}],["$","dd",null,{"children":"Диапазон от нижней до верхней границы вокруг оценки. Корректный 95%-й способ построения в длинной серии повторов накрывает настоящий эффект примерно в 95% случаев. Уровень относится к способу, а не к доле пользователей."}]]}]
15:["$","div","Нулевая гипотеза, H₀",{"children":[["$","dt",null,{"children":"Нулевая гипотеза, H₀"}],["$","dd",null,{"children":"Предположение, относительно которого проверяют необычность данных. В курсе: новая форма в среднем ничего не меняет, то есть настоящий эффект равен нулю."}]]}]
16:["$","div","p-value",{"children":[["$","dt",null,{"children":"p-value"}],["$","dd",null,{"children":"Вероятность при верной H₀ получить такую же или более экстремальную статистику по выбранному правилу. В нашем двустороннем тесте — столь же сильное или ещё большее отклонение в любую сторону от нуля. Это не вероятность самой H₀."}]]}]
17:["$","div","Уровень значимости, α",{"children":[["$","dt",null,{"children":"Уровень значимости, α"}],["$","dd",null,{"children":"Заранее выбранный порог для статистического решения. α = 5% ограничивает частоту ложных отклонений верной H₀ при корректной процедуре."}]]}]
18:["$","div","Мощность и ошибка II рода",{"children":[["$","dt",null,{"children":"Мощность и ошибка II рода"}],["$","dd",null,{"children":"Мощность — шанс обнаружить конкретный настоящий эффект выбранным тестом. Ошибка II рода — пропустить его. Если шанс пропуска β = 20%, мощность равна 80%."}]]}]
19:["$","div","Множество сравнений",{"children":[["$","dt",null,{"children":"Множество сравнений"}],["$","dd",null,{"children":"Несколько попыток обнаружить эффект: например, по разным метрикам или сегментам. Выбор одной удачной проверки после просмотра многих увеличивает риск ложной находки."}]]}]
1a:["$","div","Семейство гипотез",{"children":[["$","dt",null,{"children":"Семейство гипотез"}],["$","dd",null,{"children":"Заранее определённый набор проверок, для которого контролируют общий риск ошибки. Если выбираем находку в любом из трёх сегментов, учитываем все три сравнения, а не только сегмент с маленьким p."}]]}]
1b:["$","div","Поправка на множество сравнений",{"children":[["$","dt",null,{"children":"Поправка на множество сравнений"}],["$","dd",null,{"children":"Правило, учитывающее все проверки при статистическом решении. Бонферрони делит общий допустимый уровень ошибки на число заранее выбранных проверок. Для трёх проверок при общем α = 0,05 порог каждой равен 0,05 / 3 ≈ 0,0167. Наблюдения остаются прежними, меняется правило решения."}]]}]
1c:["$","div","Скорректированное p-value",{"children":[["$","dt",null,{"children":"Скорректированное p-value"}],["$","dd",null,{"children":"При Бонферрони исходное p умножают на число проверок m, ограничивая результат единицей. p = 0,012 при трёх проверках превращается в 0,036. Это значение сравнивают с общим α = 0,05, а не снова с α / m."}]]}]
1d:["$","div","Практический порог",{"children":[["$","dt",null,{"children":"Практический порог"}],["$","dd",null,{"children":"Эффект, достаточно большой для решения. Например, рост конверсии хотя бы на 0,5 п.п., чтобы покрыть затраты. Такой порог выбирают до просмотра результатов."}]]}]
1e:["$","div","ROI",{"children":[["$","dt",null,{"children":"ROI"}],["$","dd",null,{"children":"Return on investment — отдача на вложенные деньги. В статье eBay: добавленная рекламой выручка минус рекламные расходы, затем делённые на эти расходы. Потратили $100, добавили $37 выручки — ROI = −63%. Это не падение продаж на 63%."}]]}]
1f:["$","div","Долгосрочная ценность клиента",{"children":[["$","dt",null,{"children":"Долгосрочная ценность клиента"}],["$","dd",null,{"children":"Ценность будущих покупок и отношений с клиентом. Для решения о рекламе важна добавленная именно рекламой ценность с учётом расходов; её нельзя автоматически вывести из краткосрочного теста."}]]}]
20:["$","div","MDE",{"children":[["$","dt",null,{"children":"MDE"}],["$","dd",null,{"children":"Минимально обнаруживаемый эффект при заданной мощности и процедуре. План с MDE +0,4 п.п. и мощностью 80% обнаруживает отличие от нуля примерно в 80% повторов, если настоящий эффект равен +0,4 п.п. Это не гарантированный результат и не доказательство превышения бизнес-порога."}]]}]
21:["$","div","Размер выборки на группу",{"children":[["$","dt",null,{"children":"Размер выборки на группу"}],["$","dd",null,{"children":"Число разных участников, нужное отдельно в A и в B. Если требуется по 72 210 человек, общий объём двух групп — 144 420. Повторные визиты не создают новых независимых участников."}]]}]
22:["$","div","Окно результата",{"children":[["$","dt",null,{"children":"Окно результата"}],["$","dd",null,{"children":"Время, за которое считаем метрику для одного участника, например 7 дней после назначения. Последнему вошедшему нужно дать столько же времени, сколько первому."}]]}]
23:["$","div","Основная метрика",{"children":[["$","dt",null,{"children":"Основная метрика"}],["$","dd",null,{"children":"Заранее выбранный показатель успеха конкретного теста. Например, покупка за 7 дней. По нему планируют чувствительность и формулируют главный вывод."}]]}]
24:["$","div","Защитная метрика / guardrail",{"children":[["$","dt",null,{"children":"Защитная метрика / guardrail"}],["$","dd",null,{"children":"Показатель, который нельзя ухудшить сверх согласованного предела. Например, доля людей с ошибкой оплаты. Для проверки допуска нужны подходящий интервал и правило; большое p само по себе не доказывает безопасность."}]]}]
25:["$","div","Диагностическая метрика",{"children":[["$","dt",null,{"children":"Диагностическая метрика"}],["$","dd",null,{"children":"Помогает понять механизм изменения, например использование подсказки. Её рост не заменяет невыполненный критерий основной метрики."}]]}]
26:["$","div","OEC",{"children":[["$","dt",null,{"children":"OEC"}],["$","dd",null,{"children":"Overall evaluation criterion — общий критерий оценки продукта, связанный с ценностью для пользователей и бизнеса. Основная метрика отдельного теста должна поддерживать этот ориентир, а не просто легко расти."}]]}]
27:["$","div","Estimand",{"children":[["$","dt",null,{"children":"Estimand"}],["$","dd",null,{"children":"Точный вопрос, на который хотим получить числовой ответ. Например: насколько новая форма меняет вероятность покупки за 7 дней у новых посетителей магазина. В пятой главе используем это понятие, чтобы точно сформулировать вопрос."}]]}]
28:["$","div","Оцениватель",{"children":[["$","dt",null,{"children":"Оцениватель"}],["$","dd",null,{"children":"Правило получения оценки из данных. Например, вычесть долю покупателей в A из доли покупателей в B. Правило одно, а результат в разных выборках может отличаться."}]]}]
29:["$","div","Бриф эксперимента",{"children":[["$","dt",null,{"children":"Бриф эксперимента"}],["$","dd",null,{"children":"Договорённость до запуска: изменение, механизм, аудитория, назначение, метрики, срок и правило решения. Помогает команде проверять один и тот же вопрос."}]]}]
2a:["$","div","Единица назначения",{"children":[["$","dt",null,{"children":"Единица назначения"}],["$","dd",null,{"children":"Кому достаётся A или B: человеку, организации или, например, району на временной блок. Записей в данных на одну единицу может быть много."}]]}]
2b:["$","div","Закрепление варианта / sticky assignment",{"children":[["$","dt",null,{"children":"Закрепление варианта / sticky assignment"}],["$","dd",null,{"children":"Один и тот же участник сохраняет вариант при возвращении в рамках теста. Правила смены идентификатора определяют заранее."}]]}]
2c:["$","div","Назначение и показ / assignment и exposure",{"children":[["$","dt",null,{"children":"Назначение и показ / assignment и exposure"}],["$","dd",null,{"children":"Назначение выбирает вариант. Показ означает, что участник дошёл до места воздействия. Назначенный в B человек может не увидеть новую форму."}]]}]
2d:["$","div","ITT / intention-to-treat",{"children":[["$","dt",null,{"children":"ITT / intention-to-treat"}],["$","dd",null,{"children":"Анализ по исходному случайному назначению на заданной популяции, включая не воспользовавшихся функцией. Сохраняет первоначальное сравнение групп."}]]}]
2e:["$","div","Triggering",{"children":[["$","dt",null,{"children":"Triggering"}],["$","dd",null,{"children":"Выделение участников, для которых изменение могло сработать. Нужны одинаково определяемое условие в A/B и защита от отбора, зависящего от самого воздействия."}]]}]
2f:["$","div","Взаимное влияние / interference",{"children":[["$","dt",null,{"children":"Взаимное влияние / interference"}],["$","dd",null,{"children":"Изменение для B меняет условия A. Например, заказ B забрал общего курьера и увеличил ожидание A."}]]}]
30:["$","div","Switchback",{"children":[["$","dt",null,{"children":"Switchback"}],["$","dd",null,{"children":"Дизайн с назначением общего варианта на место и временной блок. Требует учёта связей и переноса влияния между периодами; простое чередование само по себе недостаточно."}]]}]
31:["$","div","A/A-тест",{"children":[["$","dt",null,{"children":"A/A-тест"}],["$","dd",null,{"children":"Разные случайно назначенные группы получают одинаковую функцию. Проверяют назначение, данные и метод расчёта. Отдельные ложные тревоги возможны и в исправной процедуре."}]]}]
32:["$","div","SRM / sample ratio mismatch",{"children":[["$","dt",null,{"children":"SRM / sample ratio mismatch"}],["$","dd",null,{"children":"Статистически необычное отклонение числа участников по вариантам от заданной пропорции. Сигнал для диагностики, а не доказательство эффекта функции."}]]}]
33:["$","div","Инвариант",{"children":[["$","dt",null,{"children":"Инвариант"}],["$","dd",null,{"children":"Правило или величина, которые проверяемое изменение не должно причинно менять. Прошлые покупки не меняются из-за сегодняшней формы, хотя группы могут исходно различаться случайно."}]]}]
34:["$","div","Сегмент",{"children":[["$","dt",null,{"children":"Сегмент"}],["$","dd",null,{"children":"Часть аудитории с общим признаком, например отсутствие покупок до назначения. Внутри сегмента сравниваются свои A и B. Отбор по результатам воздействия не сохраняет обычный смысл такого сравнения."}]]}]
35:["$","div","Вес сегмента",{"children":[["$","dt",null,{"children":"Вес сегмента"}],["$","dd",null,{"children":"Доля этого сегмента в целевой аудитории. Общий эффект зависит от эффектов внутри сегментов и весов, с которыми их объединяют."}]]}]
36:["$","div","Парадокс Симпсона",{"children":[["$","dt",null,{"children":"Парадокс Симпсона"}],["$","dd",null,{"children":"Направление общего сравнения может отличаться от сравнений внутри групп из-за разного состава смеси. Нужно проверить веса, периоды и дизайн, а не выбирать удобный итог."}]]}]
37:["$","div","Взаимодействие эффекта и сегмента",{"children":[["$","dt",null,{"children":"Взаимодействие эффекта и сегмента"}],["$","dd",null,{"children":"Различие эффекта B − A между сегментами. Для него оценивают собственную разность и неопределённость: два разных p-value не заменяют такую проверку."}]]}]
38:["$","div","Стратификация",{"children":[["$","dt",null,{"children":"Стратификация"}],["$","dd",null,{"children":"Назначение A/B отдельно внутри заранее заданных групп, например новичков и вернувшихся. Анализ учитывает выбранное устройство назначения."}]]}]
39:["$","div","Ковариата",{"children":[["$","dt",null,{"children":"Ковариата"}],["$","dd",null,{"children":"Дополнительный признак человека или единицы наблюдения, который используют для объяснения исхода. Для рассмотренной поправки он должен быть определён до воздействия и не зависеть от варианта."}]]}]
3a:["$","div","Корреляция, ρ",{"children":[["$","dt",null,{"children":"Корреляция, ρ"}],["$","dd",null,{"children":"Число от −1 до +1, описывающее направление и силу линейной связи. Не доказывает причинность. Нулевая корреляция не исключает другой формы зависимости."}]]}]
3b:["$","div","CUPED",{"children":[["$","dt",null,{"children":"CUPED"}],["$","dd",null,{"children":"Способ повысить точность сравнения, используя данные до эксперимента. В простом варианте из исхода вычитают предсказанный вклад прошлого признака. Не исправляет ошибку назначения или потерю данных."}]]}]
3c:["$","div","Коэффициент поправки, θ",{"children":[["$","dt",null,{"children":"Коэффициент поправки, θ"}],["$","dd",null,{"children":"Масштаб связи прошлого признака с исходом. При θ = 0,6 лишние 100 единиц прошлого соответствуют поправке 60 единиц. Его получают согласованным методом, а не выбирают ради нужного результата."}]]}]
