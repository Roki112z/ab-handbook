1f:["$","section",null,{"className":"real-story","id":"real-salmon","aria-labelledby":"real-salmon-title","children":[["$","header",null,{"className":"story-header","children":[["$","div",null,{"className":"story-kicker","children":[["$","span",null,{"children":[["$","$L23",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v16","key":"1f6ucr"}],["path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}]],"className":"lucide-book-open","size":15,"aria-hidden":"true"}]," Реальная история"]}],["$","span",null,{"children":"Постер · 2009"}]]}],["$","div",null,{"className":"story-company","children":[["$","$L23",null,{"ref":"$undefined","iconNode":[["path",{"d":"M6.5 12c.94-3.46 4.94-6 8.5-6 3.56 0 6.06 2.54 7 6-.94 3.47-3.44 6-7 6s-7.56-2.53-8.5-6Z","key":"15baut"}],["path",{"d":"M18 12v.5","key":"18hhni"}],["path",{"d":"M16 17.93a9.77 9.77 0 0 1 0-11.86","key":"16dt7o"}],["path",{"d":"M7 10.67C7 8 5.58 5.97 2.73 5.5c-1 1.5-1 5 .23 6.5-1.24 1.5-1.24 5-.23 6.5C5.58 18.03 7 16 7 13.33","key":"l9di03"}],["path",{"d":"M10.46 7.26C10.2 5.88 9.17 4.24 8 3h5.8a2 2 0 0 1 1.98 1.67l.23 1.4","key":"1kjonw"}],["path",{"d":"m16.01 17.93-.23 1.4A2 2 0 0 1 13.8 21H9.5a5.96 5.96 0 0 0 1.49-3.98","key":"1zlm23"}]],"className":"lucide-fish","size":30,"aria-hidden":"true"}],["$","span",null,{"children":"Нейронаука"}]]}],["$","h2",null,{"id":"real-salmon-title","children":"Мёртвый лосось, который «читал» эмоции"}],["$","p",null,{"className":"story-lesson","children":"Почему тысяча попыток найти эффект — не то же самое, что одна проверка."}]]}],["$","div",null,{"className":"story-body","children":[["$","h3",null,{"children":"Что сделали исследователи"}],["$","p",null,{"children":"Уже мёртвого лосося положили в МРТ-сканер и показывали фотографии людей. Проверяли, меняется ли сигнал на снимках во время показа. Сканер и обработка данных дают шум даже без мозговой деятельности."}],["$","p",null,{"children":["Изображение состоит из маленьких объёмных элементов — ",["$","strong",null,{"children":"вокселей"}],". Это как пиксели фотографии, только в трёх измерениях. В каждом проверяемом участке можно искать изменение сигнала."]}],["$","figure",null,{"className":"story-figure salmon-figure","children":[["$","div",null,{"className":"salmon-count","children":[["$","span",null,{"children":"Проверили"}],["$","strong",null,{"children":"8 064"}],["$","span",null,{"children":"вокселя — маленьких объёма на снимке"}]]}],["$","$L23",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v14","key":"s699le"}],["path",{"d":"m19 12-7 7-7-7","key":"1idqje"}]],"className":"lucide-arrow-down salmon-arrow","size":24,"aria-hidden":"true"}],["$","div",null,{"className":"salmon-findings","children":[["$","div",null,{"className":"salmon-dots","aria-hidden":"true","children":[["$","i","0",{}],["$","i","1",{}],["$","i","2",{}],["$","i","3",{}],["$","i","4",{}],["$","i","5",{}],["$","i","6",{}],["$","i","7",{}],["$","i","8",{}],["$","i","9",{}],["$","i","10",{}],["$","i","11",{}],["$","i","12",{}],["$","i","13",{}],["$","i","14",{}],["$","i","15",{}]]}],["$","div",null,{"children":[["$","strong",null,{"children":"16"}],["$","span",null,{"children":["вокселей признали значимыми",["$","br",null,{}],"без поправки на множество сравнений"]}]]}]]}],["$","figcaption",null,{"children":"Результат первоначального анализа из постера. Каждый квадрат — одна находка; это схема количества, а не снимок МРТ."}]]}],["$","p",null,{"children":["В исходном анализе использовали порог ",["$","span",null,{"className":"math-inline","dangerouslySetInnerHTML":{"__html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>p</mi><mo>&lt;</mo><mn>0,001</mn></mrow><annotation encoding=\"application/x-tex\">p &lt; 0{,}001</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.7335em;vertical-align:-0.1944em;\"></span><span class=\"mord mathnormal\">p</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span><span class=\"mrel\">&lt;</span><span class=\"mspace\" style=\"margin-right:0.2778em;\"></span></span><span class=\"katex-base\"><span class=\"katex-strut\" style=\"height:0.8389em;vertical-align:-0.1944em;\"></span><span class=\"mord\">0</span><span class=\"mord\"><span class=\"mpunct\">,</span></span><span class=\"mord\">001</span></span></span></span>"}}]," без поправки на множество сравнений и требовали скопление хотя бы из трёх вокселей. Почему даже такой маленький порог не гарантировал разумный вывод?"]}],"$L49","$L4a","$L4b","$L4c","$L4d","$L4e","$L4f"]}],"$L50"]}]
