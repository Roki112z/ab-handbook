17:["$","$L2b",null,{"id":"conversion-first","question":"Из 200 участников купили 20. Какая конверсия?","options":["10%","20%","200%"],"correct":0,"explanation":"20 делим на 200: получаем 0,1. Умножаем на 100% — это 10%. Покупателей стало больше, чем в примере выше, но доля купивших осталась такой же."}]
