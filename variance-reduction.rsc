3b:Taf4,<span class="katex-display"><span class="katex"><span class="katex-mathml"><math xmlns="http://www.w3.org/1998/Math/MathML" display="block"><semantics><mrow><msup><mi>θ</mi><mo>∗</mo></msup><mo>=</mo><mfrac><mrow><mi mathvariant="normal">Cov</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>X</mi><mo separator="true">,</mo><mi>Y</mi><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">Var</mi><mo>⁡</mo><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo></mrow></mfrac></mrow><annotation encoding="application/x-tex">\theta^*=\frac{\operatorname{Cov}(X,Y)}{\operatorname{Var}(X)}</annotation></semantics></math></span><span class="katex-html" aria-hidden="true"><span class="katex-base"><span class="katex-strut" style="height:0.7387em;"></span><span class="mord"><span class="mord mathnormal" style="margin-right:0.0278em;">θ</span><span class="msupsub"><span class="vlist-t"><span class="vlist-r"><span class="vlist" style="height:0.7387em;"><span style="top:-3.113em;margin-right:0.05em;"><span class="pstrut" style="height:2.7em;"></span><span class="katex-sizing reset-size6 size3 mtight"><span class="mbin mtight">∗</span></span></span></span></span></span></span></span><span class="mspace" style="margin-right:0.2778em;"></span><span class="mrel">=</span><span class="mspace" style="margin-right:0.2778em;"></span></span><span class="katex-base"><span class="katex-strut" style="height:2.363em;vertical-align:-0.936em;"></span><span class="mord"><span class="mopen nulldelimiter"></span><span class="mfrac"><span class="vlist-t vlist-t2"><span class="vlist-r"><span class="vlist" style="height:1.427em;"><span style="top:-2.314em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mop"><span class="mord mathrm">Var</span></span><span class="mopen">(</span><span class="mord mathnormal" style="margin-right:0.0785em;">X</span><span class="mclose">)</span></span></span><span style="top:-3.23em;"><span class="pstrut" style="height:3em;"></span><span class="frac-line" style="border-bottom-width:0.04em;"></span></span><span style="top:-3.677em;"><span class="pstrut" style="height:3em;"></span><span class="mord"><span class="mop"><span class="mord mathrm" style="margin-right:0.0139em;">Cov</span></span><span class="mopen">(</span><span class="mord mathnormal" style="margin-right:0.0785em;">X</span><span class="mpunct">,</span><span class="mspace" style="margin-right:0.1667em;"></span><span class="mord mathnormal" style="margin-right:0.2222em;">Y</span><span class="mclose">)</span></span></span></span><span class="vlist-s">​</span></span><span class="vlist-r"><span class="vlist" style="height:0.936em;"><span></span></span></span></span></span><span class="mclose nulldelimiter"></span></span></span></span></span></span>27:["$","figure",null,{"className":"formula-block","children":[["$","div",null,{"className":"formula","children":["$","span",null,{"className":"math-display","dangerouslySetInnerHTML":{"__html":"$3b"}}]}],["$","figcaption",null,{"children":"Var(X) — дисперсия прошлых значений, то есть квадрат их SD. Cov(X,Y), ковариация, описывает совместное изменение прошлого и будущего относительно их средних. Деление даёт подходящий масштаб линейной поправки, если Var(X) > 0."}]]}]
28:["$","p",null,{"children":"В реальной работе связь оценивают по данным выбранной статистической процедурой. Она должна корректно учитывать оценивание коэффициента и неопределённость результата. Подставить восемь строк в эту формулу и объявить новый p готовым рабочим анализом недостаточно."}]
29:["$","p",null,{"children":"Оценка после поправки может увеличиться или уменьшиться. Скорректированное значение отдельного человека может даже быть отрицательным. Это допустимо для расчётной величины и не означает, что клиент принёс отрицательную фактическую выручку. Итоговый эффект при корректных условиях по-прежнему выражен в рублях на человека."}]
2a:["$","aside",null,{"className":"work-note","aria-label":"На работе: Спросите не только про новую оценку, но и про её SE","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L1e",null,{"ref":"$undefined","iconNode":"$11:props:children:0:props:children:0:props:iconNode","className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Спросите не только про новую оценку, но и про её SE"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Аналитик должен использовать согласованные оценку и неопределённость, учитывать единицу рандомизации и зависимости. В отчёте укажите популяцию, окно исхода и способ корректировки. Фактические суммы оставьте отдельным описанием данных."}]}],"$undefined"]}]
2c:["$","figcaption",null,{"children":"Оставшаяся доля дисперсии. При ρ = 0,8 получаем 1 − 0,64 = 0,36: остаётся 36%, убрали 64%. Для отрицательной корреляции того же модуля идеальный выигрыш такой же, но знак коэффициента поправки другой."}]
