24:["$","aside",null,{"className":"work-note","aria-label":"На работе: Нарисуйте общий ресурс до запуска","children":[["$","div",null,{"className":"work-note-label","children":[["$","$L1f",null,{"ref":"$undefined","iconNode":"$11:props:children:0:props:iconNode","className":"lucide-briefcase-business","size":16,"aria-hidden":"true"}]," На работе"]}],["$","h3",null,{"children":"Нарисуйте общий ресурс до запуска"}],["$","div",null,{"className":"work-note-body","children":["$","p",null,{"children":"Для своего продукта отметьте общую очередь, бюджет, склад, сотрудников или рекомендации. Если действие в B меняет условия A, обсудите единицу назначения и оценку неопределённости с аналитиком до расчёта срока."}]}],"$undefined"]}]
